{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/DecidedEvaluation.json",
  "type": "object",
  "properties": {
    "product": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/StatedText.json"
    },
    "decision": {
      "anyOf": [
        {
          "type": "string",
          "const": "accepted"
        },
        {
          "type": "string",
          "const": "not_accepted"
        }
      ]
    },
    "rationale": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/StatedText.json"
    },
    "decided_by": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/PersonName.json"
    }
  },
  "required": [
    "product",
    "decision",
    "rationale",
    "decided_by"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "An overall evaluation a named person decided.",
  "additionalProperties": false
}
