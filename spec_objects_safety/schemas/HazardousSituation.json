{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/HazardousSituation.json",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/FieldDecl.json"
      },
      "minItems": 1,
      "contains": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/IdentityField.json"
      }
    },
    "provenance": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/Provenance.json"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/EvidenceRef.json"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/RelationDecl.json"
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/ClauseRef.json"
      }
    }
  },
  "required": [
    "fields"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "A hazardous situation: a case in which a hazard state coincides with\nsomething that can be hurt. It promotes the free string\n`HazardContext.situation` to a first-class object; that string stays valid\non `Hazard` and nothing here migrates it.\n\nThe seal forbids `severity`, `probability`, `score` and `acceptance`: those\nare judgements, and a judgement is a risk estimate of this situation. The\nedge to the hazard it arises from (`arises_from`) is authored in the\ndocument's relationships.",
  "additionalProperties": false
}
