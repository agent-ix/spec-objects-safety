{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/UndecidedEvaluation.json",
  "type": "object",
  "properties": {
    "product": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/StatedText.json"
    },
    "decision": {
      "type": "string",
      "const": "undecided"
    },
    "rationale": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/StatedText.json"
    }
  },
  "required": [
    "product",
    "decision"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "An overall evaluation not yet decided.",
  "additionalProperties": false
}
