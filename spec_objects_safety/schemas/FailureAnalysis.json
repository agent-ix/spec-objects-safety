{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/FailureAnalysis.json",
  "type": "object",
  "properties": {
    "effect": {
      "type": "string",
      "minLength": 1
    },
    "cause": {
      "type": "string",
      "minLength": 1
    },
    "detection": {
      "anyOf": [
        {
          "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/Detection.json"
        },
        {
          "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/EpistemicState.json"
        }
      ]
    }
  },
  "required": [
    "effect",
    "cause",
    "detection"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "The FMEA triple. `detection` is the field that earns `failure_mode` its own\ntype: a failure nobody can detect is a different engineering problem from the\nsame failure with an alarm on it, and neither severity nor likelihood carries\nthat.",
  "additionalProperties": false
}
