{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/OverallResidualRiskEvaluation.json",
  "type": "object",
  "properties": {
    "fields": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/FieldDecl.json"
      },
      "minItems": 1,
      "contains": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/IdentityField.json"
      }
    },
    "determination": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/EvaluationDetermination.json"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/EvidenceRef.json"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/RelationDecl.json"
      }
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.4.4/ClauseRef.json"
      }
    }
  },
  "required": [
    "fields"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "The overall residual-risk evaluation of one product. The residual risks and\nbenefit-risk records it considers are `references` edges authored in the\ndocument's relationships; the tooling does not aggregate them into the\ndecision.",
  "additionalProperties": false
}
