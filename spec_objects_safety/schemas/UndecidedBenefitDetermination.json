{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/UndecidedBenefitDetermination.json",
  "type": "object",
  "properties": {
    "benefit": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/StatedText.json"
    },
    "decision": {
      "type": "string",
      "const": "undecided"
    },
    "rationale": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/StatedText.json"
    }
