{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-objects-safety/0.3.0/Provenance.json",
  "type": "object",
  "properties": {
    "assertedBy": {
      "type": "string",
      "minLength": 1
    },
    "assertedAt": {
      "type": "string",
      "format": "date-time"
    },
    "standard": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "sourceSpan": {
      "$ref": "https://schemas.agent-ix.org/semantic-core/0.1.0/SourceLocus.json"
    }
  },
  "required": [
    "assertedBy",
    "assertedAt"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Who asserted a safety judgement, when, and against what. Required whenever\n`status` is `accepted` (the `allOf`/`if` rule on both record models): risk\nacceptance with nobody's name on it is the one status that must never be\nreachable by a document simply validating."
}
